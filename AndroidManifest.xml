<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pt.tvatalhos" android:versionCode="8" android:versionName="1.7">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="23" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Manutenção: descarregar o APK oficial da Netflix (TV) e libertar memória -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Android 10+ só deixa abrir apps no arranque a quem tem esta permissão -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Esperar pela internet antes de abrir a app; voltar a ligar o Wi-Fi se estiver desligado -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:label="TV Atalhos" android:icon="@drawable/icon"
        android:banner="@drawable/banner" android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:label="TV Atalhos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ecrã de manutenção: instalar Netflix (TV), libertar memória -->
        <activity android:name=".Maintenance" android:label="Manutenção" android:exported="false" />

        <!-- Modo "só esta app": serviço de acessibilidade que reabre a app quando aparece o ecrã inicial -->
        <service android:name=".GuardService" android:label="@string/guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/guard" />
        </service>

        <!-- Ecrã "A ligar à internet…" mostrado até haver internet -->
        <activity android:name=".WaitActivity" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:exported="false" />

        <!-- Ecrã "A desligar…" que acende o ecrã para escolher "Desligar" no menu da TV -->
        <activity android:name=".ShutdownActivity" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:exported="false" />

        <!-- Atalhos diretos: ficam desativados até lhes ser atribuída uma app -->
        <activity android:name=".SlotActivity" android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" android:exported="false" />
        <activity-alias android:name=".Atalho1" android:targetActivity=".SlotActivity"
            android:label="Atalho 1" android:icon="@drawable/slot1" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Atalho2" android:targetActivity=".SlotActivity"
            android:label="Atalho 2" android:icon="@drawable/slot2" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Atalho3" android:targetActivity=".SlotActivity"
            android:label="Atalho 3" android:icon="@drawable/slot3" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
